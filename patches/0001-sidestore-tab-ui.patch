@@ -0,0 +1,30 @@
+//
+//  LCSideStoreTab.swift
+//  LiveContainerSwiftUI
+//
+//  SwiftUI wrapper around the embedded built-in SideStore scene.
+//
+
+import SwiftUI
+
+@available(iOS 16.0, *)
+struct LCSideStoreTabView: UIViewControllerRepresentable {
+    var isActive: Bool
+    var onReady: () -> Void
+    var onExit: () -> Void
+    var onError: (String) -> Void
+
+    func makeUIViewController(context: Context) -> LCSideStoreTabHostViewController {
+        let vc = LCSideStoreTabHostViewController()
+        vc.onReady = { onReady() }
+        vc.onExit = { onExit() }
+        vc.onError = { message in onError(message) }
+        return vc
+    }
+
+    func updateUIViewController(_ uiViewController: LCSideStoreTabHostViewController, context: Context) {
+        if isActive {
+            uiViewController.startIfNeeded()
+        }
+    }
+}
