@@ -0,0 +1,21 @@
+//
+//  LCSideStoreTabHost.h
+//  LiveContainer
+//
+//  Hosts the built-in SideStore (running inside LiveProcess) as an
+//  embedded view so it can be shown inside a tab next to LiveContainer's UI.
+//
+
+#import <UIKit/UIKit.h>
+
+API_AVAILABLE(ios(16.0))
+@interface LCSideStoreTabHostViewController : UIViewController
+
+@property(nonatomic, copy) void (^onReady)(void);
+@property(nonatomic, copy) void (^onExit)(void);
+@property(nonatomic, copy) void (^onError)(NSString *message);
+
+- (void)startIfNeeded;
+- (void)restart;
+
+@end
diff --git a/MultitaskSupport/LCSideStoreTabHost.m b/MultitaskSupport/LCSideStoreTabHost.m
new file mode 100644
index 0000000..c93fb00
--- /dev/null
+++ b/MultitaskSupport/LCSideStoreTabHost.m
@@ -0,0 +1,101 @@
+//
+//  LCSideStoreTabHost.m
+//  LiveContainer
+//
+
+#import "LCSideStoreTabHost.h"
+#import "AppSceneViewController.h"
+
+@class LCSideStoreTabHostViewController;
+
+@interface LCSideStoreSceneDelegateProxy : NSObject <AppSceneViewControllerDelegate>
+@property(nonatomic, weak) LCSideStoreTabHostViewController *host;
+@end
+
+@interface LCSideStoreTabHostViewController () <AppSceneViewControllerDelegate>
+@end
+
+@implementation LCSideStoreSceneDelegateProxy
+
+- (void)appSceneVCAppDidExit:(AppSceneViewController *)vc {
+    LCSideStoreTabHostViewController *host = self.host;
+    dispatch_async(dispatch_get_main_queue(), ^{
+        if (host.onExit) host.onExit();
+    });
+}
+
+- (void)appSceneVC:(AppSceneViewController *)vc didInitializeWithError:(NSError *)error {
+    LCSideStoreTabHostViewController *host = self.host;
+    dispatch_async(dispatch_get_main_queue(), ^{
+        if (error) {
+            if (host.onError) host.onError(error.localizedDescription);
+        } else if (host.onReady) {
+            host.onReady();
+        }
+    });
+}
+
+- (void)appSceneVCWillActivateScene:(AppSceneViewController *)vc {
+    vc.view.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
+}
+
+@end
+
+@implementation LCSideStoreTabHostViewController {
+    AppSceneViewController *_sceneVC;
+    LCSideStoreSceneDelegateProxy *_delegateProxy;
+    BOOL _started;
+}
+
+- (void)viewDidLoad {
+    [super viewDidLoad];
+    self.view.backgroundColor = UIColor.systemBackgroundColor;
+}
+
+- (void)startIfNeeded {
+    if (_started) {
+        return;
+    }
+    _started = YES;
+
+    NSString *bundlePath = [NSBundle.mainBundle.bundlePath stringByAppendingPathComponent:@"Frameworks/SideStoreApp.framework"];
+    NSDictionary *appInfo = [NSDictionary dictionaryWithContentsOfFile:[bundlePath stringByAppendingPathComponent:@"LCAppInfo.plist"]];
+    NSString *dataUUID = appInfo[@"LCDataUUID"] ?: @"builtinSideStore";
+
+    _delegateProxy = [LCSideStoreSceneDelegateProxy new];
+    _delegateProxy.host = self;
+    _sceneVC = [[AppSceneViewController alloc] initWithBundleId:@"builtinSideStore" dataUUID:dataUUID delegate:_delegateProxy];
+    if (!_sceneVC) {
+        _started = NO;
+        if (self.onError) {
+            self.onError(@"Unable to create the SideStore scene.");
+        }
+        return;
+    }
+
+    [self addChildViewController:_sceneVC];
+    _sceneVC.view.frame = self.view.bounds;
+    _sceneVC.view.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
+    [self.view addSubview:_sceneVC.view];
+    [_sceneVC didMoveToParentViewController:self];
+}
+
+- (void)viewDidLayoutSubviews {
+    [super viewDidLayoutSubviews];
+    _sceneVC.view.frame = self.view.bounds;
+}
+
+- (void)restart {
+    _started = NO;
+    _delegateProxy.host = nil;
+    if (_sceneVC) {
+        [_sceneVC terminate];
+        [_sceneVC.view removeFromSuperview];
+        [_sceneVC removeFromParentViewController];
+        _sceneVC = nil;
+    }
+    _delegateProxy = nil;
+    [self startIfNeeded];
+}
+
+@end
